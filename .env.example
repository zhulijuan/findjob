# 在 platform.deepseek.com/api_keys 申请 API Key 后填入
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 可选：Qwen（DashScope）密钥，切换 provider 时启用（见 config.yaml llm 注释）
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# 可选：API 地址，默认 https://api.deepseek.com（代理/中转时才需要改）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：模型，默认 deepseek-flash，也可用 deepseek-v4-pro
# DEEPSEEK_MODEL=deepseek-flash
